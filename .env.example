# Copy to your private data directory/server.env using npm run server:init.
# Never commit generated access tokens or vault keys.
QUAGOEV_BIND_HOST=127.0.0.1
PORT=3001
QUAGOEV_DATA_DIR=./data-v2
QUAGOEV_ACCESS_TOKEN=
QUAGOEV_VAULT_KEY=
QUAGOEV_TELEMETRY_TOKEN=
QUAGOEV_COLLECTOR_MODE=paused
QUAGOEV_BILLING_VERIFIED=false
QUAGOEV_TELEMETRY_SOURCE_BUDGET_VERIFIED=false
# Local conservative estimate, NOT a Tesla billing cap. Check your own portal.
QUAGOEV_MONTHLY_LIMIT_USD=8
QUAGOEV_POLL_SECONDS=600
QUAGOEV_VIN=
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=
TESLA_FLEET_API=https://fleet-api.prd.na.vn.cloud.tesla.com
